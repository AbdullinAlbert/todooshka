<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/simple_task_checkBox"
        android:layout_width="36dp"
        android:layout_height="48dp"
        app:buttonIconTint="@color/task_checkbox_icon_color"
        app:buttonTint="@color/task_checkbox_states"
        app:layout_constraintBottom_toBottomOf="@+id/simple_task_description_form"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:useMaterialThemeColors="false" />

    <ru.albertabdullin.todooshka.presentation.commonWidgets.TaskEditText

        android:id="@+id/simple_task_description_form"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:autofillHints="no"
        android:background="@color/white"
        android:hint="@string/create_simple_task"
        android:inputType="textMultiLine"
        android:minHeight="48dp"
        android:textColor="@color/simple_task_form_text_color"
        app:layout_constraintEnd_toStartOf="@+id/simple_task_settings"
        app:layout_constraintStart_toEndOf="@+id/simple_task_checkBox"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/simple_task_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/task_settings_button_background_default"
        android:contentDescription="@string/simple_task_settings_button_content_description"
        android:padding="14dp"
        android:rotation="90"
        android:scaleType="fitStart"
        android:src="@drawable/discover_tune_24dp"
        app:tint="@color/task_settings_icon_states"
        app:layout_constraintBottom_toBottomOf="@+id/simple_task_description_form"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/simple_task_description_form" />

</androidx.constraintlayout.widget.ConstraintLayout>